# Deepgram — transcripción streaming (console.deepgram.com)
DEEPGRAM_API_KEY=

# Google Gemini — generación de respuestas (aistudio.google.com)
GEMINI_API_KEY=

# Opcional: modelo a usar (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Opcional: dominio base para OG images y URLs absolutas
# (default: https://copiloto-mvp.vercel.app)
# NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# Opcional: lista de espera (Google Form). Si no se setean, usan los defaults
# hardcodeados en app/api/waitlist/route.ts.
# GFORM_ACTION=https://docs.google.com/forms/d/e/XXXX/formResponse
# GFORM_EMAIL_ENTRY=entry.1234567890

# Pases ilimitados. Es la clave con la que se FIRMAN los códigos que le mandás
# a quien te paga: sin esto, /api/pass responde 500 y ningún pase se activa.
# Tiene que ser el MISMO valor acá y en Vercel; si lo cambiás, todos los pases
# que emitiste dejan de valer.
#   Crear uno:  openssl rand -base64 32
#   Emitir:     node scripts/pase.mjs cliente@mail.com        (7 días)
#               node scripts/pase.mjs cliente@mail.com year   (12 meses)
PASS_SECRET=

# Opcional: kill switch global. Con "1", /api/answer y /api/deepgram-token
# devuelven 503 y la app muestra "cupos agotados + lista de espera".
# La waitlist sigue funcionando. Freno de mano para picos de gasto.
# CAPACITY_CLOSED=1

# Opcional: PostHog para el funnel de eventos (Vercel Hobby descarta los
# eventos custom de Vercel Analytics). Sin la key, la app funciona igual.
# La misma key la usa el servidor para mandar el consumo de los modelos
# (eventos uso_llm y uso_tts). Sin ella, el consumo queda solo en los logs.
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Opcional: token del panel de consumo (/uso y /api/uso): cuánto se gastó en
# modelos, cuánto queda de saldo en Deepgram. Sin esto el panel responde 503:
# muestra información de negocio y no queremos que quede abierto por olvido.
#   Crear uno:  openssl rand -hex 16
#   Mirarlo:    https://loreado.vercel.app/uso?token=EL_TOKEN
# USO_TOKEN=

# Opcional: presupuesto mensual de los modelos, en dólares. Es contra esto que
# el panel calcula "cuánto queda": Gemini, OpenAI y Anthropic NO exponen el
# saldo de la cuenta por API, así que el límite lo ponés vos. (Deepgram sí
# informa su saldo real y no depende de esta variable.)
# PRESUPUESTO_MENSUAL_USD=50

# El contador de gasto del panel vive en Upstash: la misma base que ya usan los
# pases, con las variables que pone sola la integración de Vercel
# (KV_REST_API_URL / KV_REST_API_TOKEN). No hay nada que cargar a mano. Sin
# Upstash el consumo se sigue midiendo en los logs de Vercel y en PostHog, pero
# el panel no puede sumar totales y lo dice en pantalla.

